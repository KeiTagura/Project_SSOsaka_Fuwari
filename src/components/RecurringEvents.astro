---
interface Props {
	lang?: string;
}

const lang = Astro.props.lang === "en" ? "en" : "ja";
const isEn = lang === "en";
const prefix = isEn ? "/en" : "/ja";

const copy = isEn
	? {
			title: "Recurring Events",
			description:
				"Regular gatherings and open community times at Secret Shop. Active events will appear with an Upcoming label in the event list below.",
			items: [
				{
					title: "Open Hours",
					schedule: "Tuesday - Friday 19:00 - 23:00",
					description: "Casual drop-in hours for working, socializing, asking questions, collaborative projects, and more.",
					href: `${prefix}/space/`,
				},
				{
					title: "Secret Shop Studio",
					schedule: "Selected Saturdays, announced by cohort",
					description:
						"A guided small-team production program where participants work together to build and publish a game.",
					href: `${prefix}/studio/`,
				},
				{
					title: "Game Dev Meetup",
					schedule: "First and third Sunday of each month, afternoon",
					description:
						"A community meetup for game developers, artists, musicians, designers, and anyone interested in making games or digital media.",
					href: `${prefix}/events/`,
				},
				{
					title: "Game Night: Fight Night",
					schedule: "First Saturday of each month, 6:00 PM - 11:00 PM",
					description:
						"A casual PvP night for fighting games, versus games, team battles, rotations, and friendly competitive play.",
					href: `${prefix}/events/`,
				},
				{
					title: "Game Night: LAN Party",
					schedule: "Third Saturday of each month, 6:00 PM - 10:00 PM",
					description:
						"A casual PC and multiplayer game night for team games, co-op games, strategy games, and community picks.",
					href: `${prefix}/events/`,
				},
				{
					title: "Show & Tell",
					schedule: "Fourth Sunday of each month, time TBD",
					description:
						"Bring a project, prototype, artwork, tool, game, or idea to share with the community and get feedback.",
					href: `${prefix}/events/`,
				},
			],
		}
	: {
			title: "定期開催",
			description:
				"Secret Shopで定期的に開催される集まりや、オープンコミュニティの時間です。現在開催予定のイベントは、下のイベント一覧でご確認ください。",
			items: [
				{
					title: "Open Hours",
					schedule: "火曜日 - 金曜日 19:00 - 23:00",
					description:
						"作業、交流、質問、共同制作などに使える気軽なドロップインの時間です。",
					href: `${prefix}/space/`,
				},
				{
					title: "Secret Shop Studio",
					schedule: "土曜日不定期、コホートごとに告知",
					description:
						"小さなチームで協力しながら、ゲームの制作と公開を目指すガイド付きの制作プログラムです。",
					href: `${prefix}/studio/`,
				},
				{
					title: "Game Dev Meetup",
					schedule: "毎月第1・第3日曜日、午後",
					description:
						"ゲーム開発者、アーティスト、ミュージシャン、デザイナー、そしてゲームやデジタルメディア制作に興味がある人のためのコミュニティミートアップです。",
					href: `${prefix}/events/`,
				},
				{
					title: "Game Night: Fight Night",
					schedule: "毎月第1土曜日 18:00 - 23:00",
					description:
						"格闘ゲーム、対戦ゲーム、チーム戦、ローテーション、ゆるい競技プレイを楽しむカジュアルなPvPゲームナイトです。",
					href: `${prefix}/events/`,
				},
				{
					title: "Game Night: LAN Party",
					schedule: "毎月第3土曜日 18:00 - 22:00",
					description:
						"PCゲーム、チーム戦、協力プレイ、ストラテジーゲーム、参加者の持ち込みタイトルを楽しむカジュアルなマルチプレイイベントです。",
					href: `${prefix}/events/`,
				},
				{
					title: "Show & Tell",
					schedule: "毎月第4日曜日、時間未定",
					description:
						"プロジェクト、プロトタイプ、アート作品、ツール、ゲーム、アイデアなどを持ち寄って共有し、コミュニティからフィードバックをもらえる時間です。",
					href: `${prefix}/events/`,
				},
			],
		};
---

<section class="card-base recurring-events px-8 py-6 mb-6">
	<div class="recurring-events__header">
		<h2>{copy.title}</h2>
		<p>{copy.description}</p>
	</div>

	<div class="recurring-events__grid">
		{copy.items.map((item) => (
			<a class="recurring-events__item" href={item.href}>
				<span class="recurring-events__schedule">{item.schedule}</span>
				<h3>{item.title}</h3>
				<p>{item.description}</p>
			</a>
		))}
	</div>
</section>

<style>
	.recurring-events {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background-color: var(--btn-regular-bg);
	}

	.recurring-events__header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.recurring-events__header h2 {
		margin: 0;
		color: #d24200;
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1.15;
	}

	.recurring-events__header p {
		margin: 0;
		color: var(--text-50);
	}

	.recurring-events__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.875rem;
	}

	.recurring-events__item {
		display: flex;
		min-height: 10rem;
		flex-direction: column;
		gap: 0.5rem;
		border: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--card-bg) 82%, transparent);
		padding: 1rem;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background 160ms ease,
			border-color 160ms ease;
	}

	.recurring-events__item:hover {
		transform: translateY(-2px);
		border-color: var(--primary);
		background: var(--btn-plain-bg-hover);
		color: white;
	}

	.recurring-events__schedule {
		color:  var(--btn-regular-bg);
		font-size: 0.875rem;
		font-weight: 800;
	}

	.recurring-events__item h3 {
		margin: 0;
		color: #d24200;
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.2;
	}

	.recurring-events__item p {
		margin: 0;
		color: white;
		line-height: 1.55;
	}

	@media (max-width: 640px) {
		.recurring-events {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}

		.recurring-events__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
