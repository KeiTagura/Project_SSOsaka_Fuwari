---
import type { CollectionEntry } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import PostMeta from "@components/PostMeta.astro";
import { getPostUrlBySlug, getPostUrlBySlugLang } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const { post, lang } = Astro.props as { post: any; lang?: string };
const { Content, data } = await post.render();

// Extract custom featured excerpt between markers in raw markdown body
// Markers used in markdown:
// [comment]: <FeaturedDescription>
let featuredExcerptHtml: string | undefined;
try {
	const body: string = (post as any).body ?? "";
	const MARK = "[comment]: <FeaturedDescription>";
	const first = body.indexOf(MARK);
	const second = first >= 0 ? body.indexOf(MARK, first + MARK.length) : -1;
	if (first >= 0 && second > first) {
		const slice = body.slice(first + MARK.length, second).trim();
		// Minimal markdown to HTML: convert links and paragraph breaks
		const linkified = slice.replace(
			/\[([^\]]+)\]\(([^)]+)\)/g,
			'<a href="$2">$1<\/a>',
		);
		const paragraphs = linkified
			.split(/\n\s*\n+/)
			.map((p) => `<p>${p.trim()}<\/p>`)
			.join("\n");
		featuredExcerptHtml = paragraphs;
	}
} catch {}
// Resolve relative image path robustly

let imageUrl = post.data.image;
const isAbsolute = (p: string) =>
	typeof p === "string" && (p.startsWith("/") || /^https?:\/\//.test(p));

if (imageUrl && !isAbsolute(imageUrl)) {
	// Build the REAL directory from collection + slug (don’t use post.id)
	const collection = post.collection; // e.g. "posts"
	// Use the full slug path as a directory (e.g., "ja/zigday00"), since localized posts live under lang folders
	const slugDir = post.slug;

	const dirPath = `/src/content/${collection}/${slugDir}`; // -> "/src/content/posts/ja/zigday00"

	// Assets available under content
	const assets = import.meta.glob(
		"/src/content/**/*.{jpg,jpeg,png,webp,avif,gif,svg}",
		{ query: "?url", import: "default" },
	);

	// 1) Try cover.*
	const coverKey = Object.keys(assets).find((k) =>
		k.startsWith(`${dirPath}/cover.`),
	);

	if (coverKey) {
		imageUrl = await (assets as Record<string, () => Promise<string>>)[
			coverKey
		]();
	} else {
		// 2) Try the exact relative filename from frontmatter (e.g., ./cover.jpg)
		const relClean = String(imageUrl).replace(/^\.?\//, "");
		const exactKey = `${dirPath}/${relClean}`;
		if (exactKey in assets) {
			imageUrl = await (assets as Record<string, () => Promise<string>>)[
				exactKey
			]();
		} else {
			console.warn(
				`Image not found for ${post.slug}: tried ${dirPath}/cover.* and ${exactKey}`,
			);
			imageUrl = undefined;
		}
	}
}

---

<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
  <div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
    <!-- Optional word count section if you calculate it -->
    <!-- title -->
    <div class="relative">
      <h1 class="text-3xl font-bold mb-3 text-white">{post.data.title}</h1>
    </div>

    <!-- metadata -->
    <PostMeta
      class="mb-5"
      published={post.data.published}
      updated={post.data.updated}
      tags={post.data.tags}
      category={post.data.category}
    />

    <!-- Image -->
    {imageUrl && (
      <div class="img-boarder">
        <img src={imageUrl} alt={post.data.title} class="mb-8 rounded-xl banner-container" />
      </div>
    )}

    <!-- Featured excerpt: prefer custom marker-defined snippet; else description; else first paragraphs -->
    <div class="featured-excerpt">
      {featuredExcerptHtml ? (
        <Markdown class="mb-6 markdown-content" content={featuredExcerptHtml} />
      ) : post.data.description ? (
        <div class="mb-6 markdown-content"><p>{post.data.description}</p></div>
      ) : (
        <Markdown class="mb-6 markdown-content">
          <Content />
        </Markdown>
      )}
      <div >
         <a class="featured-post mb-8 p-6 rounded-lg bg-[var(--card-bg-featured)] btn-regular-featured" href={getPostUrlBySlugLang(post.slug, lang)}>READ MORE</a>
      </div>
    </div>
    <!-- 
 <a href={getPostUrlBySlug(post.slug)} aria-label={post.data.title} class="!hidden md:!flex btn-regular w-[3.25rem]
         absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
         hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95
        ">
  -->
        </a>
  </div>
</div>

