---

import I18nKey from "../../i18n/i18nKey";
import { i18nFor } from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { getLangFromPath } from "../../utils/lang";
import { getTagUrlLang } from "../../utils/url-utils";

import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

const routeLang = getLangFromPath(Astro.url.pathname) ?? undefined;
const t = i18nFor(routeLang ?? "ja");
const tags = await getTagList(routeLang);

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---
<WidgetLayout name={t(I18nKey.tags)} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(item => (
            <ButtonTag href={getTagUrlLang(item.name, routeLang)} label={`View all posts with the ${item.name.trim()} tag`}>
                {item.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>