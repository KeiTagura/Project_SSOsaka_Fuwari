  .studio-foldout {
    border: 1px solid var(--line-divider);
    border-radius: 0.75rem;
    background: var(--card-bg);
    margin: 1rem 0;
    overflow: hidden;
  }

  .studio-foldout > summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.125rem;
    font-weight: 700;
    color: var(--btn-regular-bg);
    list-style: none;
    user-select: none;
  }

  .studio-foldout > summary::-webkit-details-marker {
    display: none;
  }

  .studio-foldout > summary::after {
    content: "+";
    flex: 0 0 auto;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .studio-foldout[open] > summary::after {
    transform: rotate(45deg);
  }

  .studio-foldout-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      grid-template-rows 240ms ease,
      opacity 180ms ease,
      transform 180ms ease;
    padding: 0 1.125rem;
  }

  .studio-foldout-content-inner {
    min-height: 0;
    color: white;
    overflow: hidden;
  }

  .studio-foldout[open]:not(.is-closing) > .studio-foldout-content {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
    padding-bottom: 1.125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-foldout > summary::after,
    .studio-foldout-content {
      transition: none;
    }
  }
