---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import gameScreen from "../assets/images/gameScreen.png";
import roleScreen from "../assets/images/ssShopWorkArea.png";
import studioBanner from "../assets/images/SSStudio_Banner.png";
import taemComposition from "../assets/images/teamComposition.png";
import outFishing from "../assets/images/outFishing.png";
import vend from "../assets/images/vend.png";
import meshOut from "../assets/images/meshOut.png";
import MainGridLayout from "../layouts/MainGridLayout.astro";

interface Props {
	lang?: "en" | "ja";
}

const routeLang = Astro.props.lang ?? "en";

const studioEntry =
	routeLang === "ja"
		? ((await getEntry("spec", "ja/studio" as any)) ??
			(await getEntry("spec", "en/studio" as any)))
		: await getEntry("spec", "en/studio" as any);
if (!studioEntry) {
	throw new Error("Studio page content not found");
}
const { Content } = await render(studioEntry);
const studioBannerImage = `url("${studioBanner.src}")`;
const studioGameScreenImage = `url("${gameScreen.src}")`;
const secretShopRoleImage = `url("${roleScreen.src}")`;
const teamCompositionImage = `url("${taemComposition.src}")`;
const registerImage = `url("${outFishing.src}")`;
const meshOutImage = `url("${meshOut.src}")`;
const vendImage = `url("${vend.src}")`;
---

<MainGridLayout title={routeLang === "ja" ? "スタジオ" : "Studio"} description={routeLang === "ja" ? "スタジオ" : "Studio"}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="mt-2 studio-markdown">
        <Content />
      </Markdown>
    </div>
  </div>
</MainGridLayout>

<style is:global define:vars={{ studioBannerImage, studioGameScreenImage, secretShopRoleImage, teamCompositionImage, registerImage, meshOutImage, vendImage }}>
  
.custom-md .custom-code {
      background: #13161a;
      border-radius: 0.875rem;
      box-sizing: border-box;
      max-width: 100%;
      overflow: visible;
      white-space: normal;
      counter-reset: custom-code-line;

}

.custom-md .custom-code > code {
      display: block;
      max-width: 100%;
      overflow: visible;
      background: transparent;
      padding: 0;
      border-radius: 0;
      color: inherit;
      font: inherit;
      white-space: normal;
}

.custom-md .custom-code .custom-code-line {
      counter-increment: custom-code-line;
      display: block;
      position: relative;
      box-sizing: border-box;
      max-width: 100%;
      min-width: 0;
      min-height: 1.5rem;
      padding-left: 3.625rem;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: break-word;
}

.custom-md .custom-code .custom-code-line::before {
      content: counter(custom-code-line);
      position: absolute;
      left: 0;
      top: 0;
      width: 2.75rem;
      border-right: 1px solid rgb(255 255 255 / 0.18);
      color: #777;
      padding-right: 0.75rem;
      text-align: right;
      user-select: none;
}

