---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets, getLinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import { getLangFromPath } from "../utils/lang";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const routeLang = getLangFromPath(Astro.url.pathname) ?? undefined;
const presets = getLinkPresets(routeLang);

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return presets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div> <!-- used for onload animation -->
    <div class:list={[
        className,
        "card-base !overflow-visible relative max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
       
        <div id="navbar-links" class="hidden md:flex absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div id="navbar-controls" class="flex absolute right-4 top-1/2 -translate-y-1/2">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search> 
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <!-- <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon> -->
                    </button>
            )}
            <button aria-label="Language" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="lang-toggle">
                <Icon name="material-symbols:translate" class="text-[1.25rem]"></Icon>
            </button>
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <div id="lang-select-panel" class="float-panel float-panel-closed absolute right-16 top-[4.5rem] z-50">
            <div class="card-base p-2 rounded-xl flex flex-col gap-2 min-w-[6rem]">
                <button id="lang-en" data-lang="en" class="btn-regular px-3 py-1 rounded-lg flex items-center gap-1 w-full justify-between">
                    <span data-check class="hidden">✓</span>
                    <span>EN</span>
                </button>
                <button id="lang-ja" data-lang="ja" class="btn-regular px-3 py-1 rounded-lg flex items-center gap-1 w-full justify-between">
                    <span data-check class="hidden">✓</span>
                    <span>JA</span>
                </button>
            </div>
        </div>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let langBtn = document.getElementById("lang-toggle");
    if (langBtn) {
        langBtn.onclick = function () {
            const panel = document.getElementById('lang-select-panel');
            if (panel) {
                panel.classList.toggle('float-panel-closed');
                try { updateLangUI(getCurrentLang()); } catch {}
            }
        }
        // Hover-to-open language panel
        const panel = document.getElementById('lang-select-panel');
        if (panel) {
            let hoverTimer = null as any;
            const open = () => {
                panel.classList.remove('float-panel-closed');
                try { updateLangUI(getCurrentLang()); } catch {}
            };
            const close = () => panel.classList.add('float-panel-closed');
            const cancel = () => { if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; } };

            langBtn.addEventListener('mouseenter', () => { cancel(); open(); });
            panel.addEventListener('mouseenter', () => { cancel(); open(); });
            langBtn.addEventListener('mouseleave', () => { cancel(); hoverTimer = setTimeout(close, 150); });
            panel.addEventListener('mouseleave', () => { cancel(); hoverTimer = setTimeout(close, 150); });
        }
    }

    function getCurrentLang() {
        const params = new URLSearchParams(window.location.search);
        const q = (params.get('lang') || '').toLowerCase();
        if (q === 'en' || q === 'ja') return q;
        const segs = window.location.pathname.split('/').filter(Boolean);
        if (segs[0] === 'en' || segs[0] === 'ja') return segs[0];
        if (segs[0] === 'posts' && (segs[1] === 'en' || segs[1] === 'ja')) return segs[1];
        return 'ja';
    }

    function updateLangUI(current) {
        const enBtn = document.getElementById('lang-en');
        const jaBtn = document.getElementById('lang-ja');
        const sets = [enBtn, jaBtn];
        sets.forEach((btn) => {
            if (!btn) return;
            const lang = btn.getAttribute('data-lang');
            const check = btn.querySelector('[data-check]');
            if (lang === current) {
                btn.classList.add('ring-1','ring-[var(--primary)]');
                btn.classList.remove('opacity-60');
                if (check) check.classList.remove('hidden');
                btn.setAttribute('aria-current','true');
            } else {
                btn.classList.remove('ring-1','ring-[var(--primary)]');
                btn.classList.add('opacity-60');
                if (check) check.classList.add('hidden');
                btn.removeAttribute('aria-current');
            }
        });
    }

    function navigateToLang(target) {
        try {
            const path = window.location.pathname;
            const parts = path.split('/').filter(Boolean);
            const trailingSlash = path.endsWith('/');
            const localeIdxs = parts
                .map((seg, i) => ((seg === 'en' || seg === 'ja') ? i : -1))
                .filter(i => i >= 0);
            let idx = -1;
            if (parts[0] === 'posts' && (parts[1] === 'en' || parts[1] === 'ja')) {
                idx = 1;
            } else if (parts[0] === 'en' || parts[0] === 'ja') {
                idx = 0;
            } else if (localeIdxs.length > 0) {
                idx = localeIdxs[0];
            }
            // Neutral paths: root, about, archive
            if (parts.length === 0 || ((parts[0] === 'about' || parts[0] === 'archive') && localeIdxs.length === 0)) {
                const params = new URLSearchParams(window.location.search);
                params.set('lang', target);
                const base = parts.length === 0 ? '/' : `/${parts[0]}` + (trailingSlash ? '/' : '');
                const newUrl = base + (params.toString() ? ('?' + params.toString()) : '');
                try { localStorage.setItem('preferredLang', target); } catch {}
                window.location.assign(newUrl);
                return;
            }
            let next = parts.slice();
            if (localeIdxs.length > 1) {
                next = next.filter((_, i) => i === idx || !(localeIdxs.includes(i)));
            }
            if (idx >= 0) {
                next[idx] = target;
            } else {
                if (next[0] === 'posts') {
                    next.splice(1, 0, target);
                } else {
                    next.unshift(target);
                }
            }
            const newPath = '/' + next.join('/') + (trailingSlash ? '/' : '');
            try { localStorage.setItem('preferredLang', target); } catch {}
            window.location.assign(newPath);
        } catch (e) {
            console.error(e);
        }
    }

    const btnEn = document.getElementById('lang-en');
    if (btnEn) {
        btnEn.onclick = function () {
            updateLangUI('en');
            const panel = document.getElementById('lang-select-panel');
            if (panel) panel.classList.add('float-panel-closed');
            navigateToLang('en');
        };
    }
    const btnJa = document.getElementById('lang-ja');
    if (btnJa) {
        btnJa.onclick = function () {
            updateLangUI('ja');
            const panel = document.getElementById('lang-select-panel');
            if (panel) panel.classList.add('float-panel-closed');
            navigateToLang('ja');
        };
    }

    // Initialize selection state on load
    try { updateLangUI(getCurrentLang()); } catch {}

    // Click-outside to close language panel
    document.addEventListener('click', function (e) {
        const panel = document.getElementById('lang-select-panel');
        const btn = document.getElementById('lang-toggle');
        if (!panel || !btn) return;
        const target = e.target;
        if (panel.contains(target as any) || btn.contains(target as any)) return;
        panel.classList.add('float-panel-closed');
    });
}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
