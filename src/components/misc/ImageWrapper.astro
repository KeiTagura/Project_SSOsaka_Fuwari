---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	const normalizedBase = path
		.normalize(path.join("../../", basePath))
		.replace(/\\/g, "/");
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	let file = files[normalizedPath];
	if (!file) {
		// Fallback: try cover.* inside the same basePath directory
		const coverKey = Object.keys(files).find((k) =>
			k.startsWith(`${normalizedBase}cover.`),
		);
		if (coverKey) {
			file = files[coverKey];
		} else {
			console.error(
				`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
			);
		}
	}
	if (file) {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none">
	
<div id="title-wrapper"
     class="absolute inset-0 z-20 flex items-center justify-center
            pointer-events-none
            opacity-0 transition-opacity duration-700 ease-out">
  <!-- your #title / #titleText content -->

  <!-- Full width background container -->
  <div id="title"
       style="background-color: rgba(0, 0, 0, 0.479); width: 100%; padding: 2vh ;"
       class="flex justify-center">

    <!-- Text container -->
    <div id="titleText"
         class="relative font-maniac font-bold text-6xl md:text-9xl leading-none text-amber-500 drop-shadow-lg opacity-0"
         style="animation: titleTextFadeIn 0.7s ease-out 1.5s forwards;">
      SS Osaka

      <!-- Subtitle aligned to left edge of titleText -->
      <div id="subtitle"
		   
           class=" -mt-[2px] md:-mt-4 absolute right-0 top-full mt-1 font-sans text-lg md:text-2xl leading-tight text-amber-500">
        SS オオサカ
      </div>
      </div>
 
    </div>

  </div>

	</div>




	
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>

<style>
@keyframes titleTextFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
</style>
