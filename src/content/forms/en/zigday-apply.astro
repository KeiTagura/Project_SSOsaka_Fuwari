---
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
---
<MainGridLayout title="Apply as Speaker" description="Zig Day speaker application form">
  <div class="max-w-3xl mx-auto">
    <div class="card-base rounded-2xl overflow-hidden p-0">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSeLuuCIk2ou3eaX8kzCm30d1GZ0mhWclQT73McYGsmAcY3GBw/viewform?embedded=true"
        width="100%"
        height="2200"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        style="border:0; display:block; background:transparent;"
      >Loading…</iframe>
    </div>
  </div>
</MainGridLayout>
