---
import ArchivePanel from "@components/ArchivePanel.svelte";
import RecurringEvents from "@components/RecurringEvents.astro";
import I18nKey from "@i18n/i18nKey";
import { i18nFor } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";
import { getLangFromPath } from "../utils/lang";

const path = Astro.url.pathname;
const pathLang = getLangFromPath(path) ?? undefined;
const qLangRaw = Astro.url.searchParams.get("lang")?.toLowerCase?.();
const qLang = qLangRaw === "en" || qLangRaw === "ja" ? qLangRaw : undefined;
const lang = qLang ?? pathLang ?? "ja";
const t = i18nFor(lang);
// Pass full list; client filters by chosen language
const sortedPostsList = await getSortedPostsList();
---

<MainGridLayout title={t(I18nKey.events)}>
    <RecurringEvents lang={lang} />
    <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
</MainGridLayout>


<script is:inline>
	const params = new URLSearchParams(window.location.search);
	const lang = (params.get("lang") || "").toLowerCase();
	if (lang === "en" || lang === "ja") {
		params.delete("lang");
		window.location.replace(`/${lang}/events/${params.toString() ? `?${params.toString()}` : ""}`);
	}
</script>