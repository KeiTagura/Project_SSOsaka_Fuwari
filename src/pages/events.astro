---
import Calendar from "../components/Calendar";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { i18nFor } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import { getLangFromPath } from "@/utils/lang";


let delay = 0;
const interval = 50;
---

const routeLang = getLangFromPath(Astro.url.pathname) ?? "ja";
const t = i18nFor(routeLang);

<MainGridLayout title={t(I18nKey.events)} description={t(I18nKey.events)}>
    
      <!-- Inject Bootstrap CSS via <head> slot -->

    
    <div class="card-base z-10 px-9 py-6 relative w-full ">

        <Calendar 
        
        client:only="react" />
  
    </div>

    <div class="card-base z-10 px-9 py-6 relative w-full h-[700px]" >
    </div>

</MainGridLayout>

