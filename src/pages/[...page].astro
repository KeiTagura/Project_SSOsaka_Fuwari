---






import {
	type CollectionEntry,
	getCollection,
	getEntry,
	render,
} from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import PostFeatured from "@components/PostFeatured.astro";
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import I18nKey from "../i18n/i18nKey";
import { i18nFor } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getLangFromPath } from "../utils/lang";

// Helper so it works whether published is a Date or string
const toDate = (d: unknown) => (d instanceof Date ? d : new Date(String(d)));
const now = new Date();

// Load posts: exclude drafts and future-published posts
type Post = CollectionEntry<"posts">;
const posts: Post[] = await getCollection("posts", ({ data }) => {
	if (data.draft) return false;
	if (import.meta.env.PROD && new Date(data.published) > now) return false;
	return true;
});

// Choose featured posts per language: soonest upcoming featured; fallback = latest past featured
function getItemLangFromSlug(slug: string, fmLang?: string): "en" | "ja" | "" {
	const fm = fmLang?.toLowerCase?.();
	if (fm === "en" || fm === "ja") return fm as any;
	const first = String(slug).split("/")?.[0]?.toLowerCase?.();
	return first === "en" || first === "ja" ? (first as any) : "";
}
const candidates = posts.filter((p) => !!p.data.featured);
const candEn = candidates.filter(
	(p) => getItemLangFromSlug(p.slug, (p.data as any)?.lang) === "en",
);
const candJa = candidates.filter(
	(p) => getItemLangFromSlug(p.slug, (p.data as any)?.lang) === "ja",
);

const eventDateOf = (p: Post) => toDate(p.data.eventDate ?? p.data.published);

const upcomingEn = candEn
	.filter((p) => eventDateOf(p) >= now)
	.sort((a, b) => eventDateOf(a).getTime() - eventDateOf(b).getTime());
const pastEn = candEn
	.filter((p) => eventDateOf(p) < now)
	.sort((a, b) => eventDateOf(b).getTime() - eventDateOf(a).getTime());
const featuredEn: Post | undefined = upcomingEn[0] ?? pastEn[0];

const upcomingJa = candJa
	.filter((p) => eventDateOf(p) >= now)
	.sort((a, b) => eventDateOf(a).getTime() - eventDateOf(b).getTime());
const pastJa = candJa
	.filter((p) => eventDateOf(p) < now)
	.sort((a, b) => eventDateOf(b).getTime() - eventDateOf(a).getTime());
const featuredJa: Post | undefined = upcomingJa[0] ?? pastJa[0];

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const nowRef = new Date();
	const upcomingOnly = allBlogPosts.filter(
		(p) => new Date(String(p.data.eventDate ?? p.data.published)) >= nowRef,
	);
	return paginate(upcomingOnly, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

// Past events: all non-draft posts whose eventDate (or published) is before now, newest first
const allPastEvents = posts
	.filter((p) => eventDateOf(p) < now)
	.sort((a, b) => eventDateOf(b).getTime() - eventDateOf(a).getTime());
const pastEventsEn = allPastEvents
	.filter((p) => getItemLangFromSlug(p.slug, (p.data as any)?.lang) === "en")
	.slice(0, 2);
const pastEventsJa = allPastEvents
	.filter((p) => getItemLangFromSlug(p.slug, (p.data as any)?.lang) === "ja")
	.slice(0, 2);

const { page } = Astro.props;
// Filter out the featured post from the current page list to avoid duplication (both locales)
function normalizeSlug(slug: string): string {
	const parts = String(slug).split("/");
	const first = parts[0]?.toLowerCase?.();
	if (first === "en" || first === "ja") return parts.slice(1).join("/");
	return slug;
}
const excludeSet = new Set<string>(
	[
		featuredEn ? normalizeSlug(featuredEn.slug) : "",
		featuredJa ? normalizeSlug(featuredJa.slug) : "",
	].filter(Boolean),
);
const pageFiltered =
	excludeSet.size > 0
		? {
				...page,
				data: page.data.filter((p) => !excludeSet.has(normalizeSlug(p.slug))),
			}
		: page;
const len = pageFiltered.data.length;

// Localized Access content
const pathLang = getLangFromPath(Astro.url.pathname) ?? undefined;
const qLangRaw = Astro.url.searchParams.get("lang")?.toLowerCase?.();
const qLang = qLangRaw === "en" || qLangRaw === "ja" ? qLangRaw : undefined;
const routeLang = qLang ?? pathLang ?? "ja";

const accessEn = await getEntry("access" as any, "en/access" as any);
const accessJa = await getEntry("access" as any, "ja/access" as any);
const AccessEn = accessEn ? (await render(accessEn)).Content : null;
const AccessJa = accessJa ? (await render(accessJa)).Content : null;

const studioEntry = await getEntry("spec", "en/studio" as any);
if (!studioEntry) {
	throw new Error("Studio preview content not found");
}
function getFeaturedDescription(body: string): string {
	const mark = "[comment]: <FeaturedDescription>";
	const first = body.indexOf(mark);
	const second = first >= 0 ? body.indexOf(mark, first + mark.length) : -1;
	if (first < 0 || second <= first) return "";
	return body.slice(first + mark.length, second).trim();
}
const studioExcerptHtml = getFeaturedDescription((studioEntry as any).body ?? "");

---

<MainGridLayout>
  
    {featuredEn && (
      <div id="featured-en" data-lang="en" class="featured-post mb-8 p-6 rounded-lg bg-[var(--card-bg-featured)]" style={routeLang === 'en' ? '' : 'display:none'}>
        <PostFeatured post={featuredEn} lang="en" />
      </div>
    )}
    {featuredJa && (
      <div id="featured-ja" data-lang="ja" class="featured-post mb-8 p-6 rounded-lg bg-[var(--card-bg-featured)]" style={routeLang === 'ja' ? '' : 'display:none'}>
        <PostFeatured post={featuredJa} lang="ja" />
      </div>
    )}

  <section id="studio" class="scroll-mt-28 mb-8 p-6 rounded-lg bg-[var(--card-bg-featured)]">
    <!--bg-[var(--bth-card-bh-hover-alt)]-->
      <div class="  flex justify-center text-6xl font-semibold text-90">Studio</div>

    <div class="card-base mt-4 h-[0.5rem] dark:bg-[var(--card-bg)]"></div>
        </br>
    <div class="grid gap-6 md:grid-cols-[1.05fr_0.95fr] items-center">
      <div id="studio-promo-en" data-lang="en" class="space-y-4" style={routeLang === 'en' ? '' : 'display:none'}>
        <div class="text-white text-lg leading-8 ">
        <p class = "text-center text-xl font-medium"> Form a team, build a small game, finish it, and publish it. </p>
        </br>
       
            <p class = "text-center text-3xl font-semibold">
            📚 Learn. 
            🤝 Collaborate. 
            🚀 Ship. </br>
            🎉 Showcase!
            </p>
        </br>
        </br>
        </div>

        </br></br>
        <!--<Markdown class="studio-preview text-lg leading-8 text-75" content={studioExcerptHtml} />-->
        <div class = "flex justify-center">
          <a class="text-[#d24200] featured-post p-4 rounded-lg bg-[var(--card-bg-featured)] btn-regular-featured w-full" href="/en/studio/">
            READ MORE
          </a>
        </div>
      </div>
      <div id="studio-promo-ja" data-lang="ja" class="space-y-4" style={routeLang === 'ja' ? '' : 'display:none'}>
        <div class="text-white text-lg leading-8 ">
        <p class = "text-center text-xl font-medium">チームを作り、小さなゲームを制作し、完成させて公開する。</p>
        </br>

            <p class = "text-center text-3xl font-semibold">
            学ぶ。
            協力する。
            完成させる。</br>
            発表する！
            </p>
        </br>
        </br>
        </div>

        </br></br>
        <div class = "flex justify-center">
          <a class="text-[#d24200] featured-post p-4 rounded-lg bg-[var(--card-bg-featured)] btn-regular-featured w-full" href="/ja/studio/">
            詳しく見る
          </a>
        </div>
      </div>
      <!--  <div class="relative aspect-[16/10] rounded-2xl overflow-hidden">
       
        <img src="src/assets/images/SSSStudio_Front.png" alt="Secret Shop Osaka studio" class="w-full h-full object-cover" />
        <div aria-hidden="true" class="absolute inset-0 pointer-events-none" style="background-image: url('/images/overlays/overlay11.png'); background-repeat: repeat; opacity: 0.45;"></div>
      
      </div>-->
    </div>
    </br>
  </section>

  <div
    id="home-title-en"
    data-lang="en"
    class="text-5xl font-semibold text-center text-[#d24200]"
    style={routeLang === 'en' ? '' : 'display:none'}
  >{i18nFor('en')(I18nKey.upcomingEvents)}</div>
  <div
    id="home-title-ja"
    data-lang="ja"
    class="text-5xl font-semibold text-center text-[#d24200]"
    style={routeLang === 'ja' ? '' : 'display:none'}
  >{i18nFor('ja')(I18nKey.upcomingEvents)}</div>
    <div id="home-post-list">
      <PostPage page={pageFiltered} lang={routeLang} ></PostPage>
    </div>
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}>
      </Pagination>


{(pastEventsEn.length > 0 || pastEventsJa.length > 0) && (
  <>
    <div class="card-base mt-4 h-[0.5rem] dark:bg-[var(--card-bg-featured)]"></div>
    {pastEventsEn.length > 0 && (
      <div
        id="past-title-en"
        data-lang="en"
        class="text-5xl font-semibold text-center text-[#d24200] mt-8"
        style={routeLang === 'en' ? '' : 'display:none'}
      >{i18nFor('en')(I18nKey.pastEvents)}</div>
    )}
    {pastEventsJa.length > 0 && (
      <div
        id="past-title-ja"
        data-lang="ja"
        class="text-5xl font-semibold text-center text-[#d24200] mt-8"
        style={routeLang === 'ja' ? '' : 'display:none'}
      >{i18nFor('ja')(I18nKey.pastEvents)}</div>
    )}
    <div id="past-post-list">
      {pastEventsEn.length > 0 && <PostPage page={{ data: pastEventsEn }} lang="en" />}
      {pastEventsJa.length > 0 && <PostPage page={{ data: pastEventsJa }} lang="ja" />}
    </div>
    <div class="flex justify-center mt-2 mb-4">
      {pastEventsEn.length > 0 && (
        <a id="past-more-en" href="/events/"
           class="btn-regular-featured px-6 py-2 rounded-lg"
           style={routeLang === 'en' ? '' : 'display:none'}>
          View All Past Events →
        </a>
      )}
      {pastEventsJa.length > 0 && (
        <a id="past-more-ja" href="/events/"
           class="btn-regular-featured px-6 py-2 rounded-lg"
           style={routeLang === 'ja' ? '' : 'display:none'}>
          過去のイベントをすべて見る →
        </a>
      )}
    </div>
  </>
)}

<div class="card-base mt-8 h-[0.5rem] dark:bg-[var(--card-bg-featured)]"></div>


<div id="access" class="max-w-6xl mx-auto p-4 space-y-4">
  <div class="text-5xl font-semibold text-center text-[#d24200]">Access</div>

  <div class="grid gap-4 md:grid-cols-3">
    <aside id="access-info" class="h-[34rem] md:col-span-1 shrink-0 text-sm rounded-xl border p-4 text-90 flex items-center">
      <Markdown class="prose prose-invert max-w-none mx-auto text-center">
        {AccessEn && (
          <div id="access-en" data-lang="en" style={routeLang === 'en' ? '' : 'display:none'}>
            <AccessEn />
          </div>
        )}
        {AccessJa && (
          <div id="access-ja" data-lang="ja" style={routeLang === 'ja' ? '' : 'display:none'}>
            <AccessJa />
          </div>
        )}
      </Markdown>
    </aside>
    <div id="access-media" class="flex flex-col gap-4 h-[34rem] md:col-span-2">
      <aside id="access-img" class="relative flex-1 w-full rounded-2xl overflow-hidden">
        <img src="/images/LocationShot.webp" alt="Access" class="w-full h-full object-cover" />
        <div aria-hidden="true" class="absolute inset-0 pointer-events-none" style="background-image: url('/images/overlays/overlay11.png'); background-repeat: repeat; opacity: 0.8;"></div>
      </aside>
      <main id="access-map" class="flex-1 w-full rounded-2xl overflow-hidden">
        <iframe
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=34.64246579608249, 135.50556859266723&z=15&output=embed">
        </iframe>
      </main>
    </div>
  </div>
</div>


<script>
  (function(){
    function selectedLang(){
      try {
        const params = new URLSearchParams(window.location.search);
        const q = (params.get('lang')||'').toLowerCase();
        if (q === 'en' || q === 'ja') return q;
        const parts = window.location.pathname.split('/').filter(Boolean);
        const first = parts[0]?.toLowerCase?.();
        if (first === 'en' || first === 'ja') return first;
        const pref = (localStorage.getItem('preferredLang')||'').toLowerCase();
        if (pref === 'en' || pref === 'ja') return pref;
      } catch {}
      return 'ja';
    }
    function filterHome(){
      const cur = selectedLang();
      ['home-post-list', 'past-post-list'].forEach(function(id){
        const root = document.getElementById(id);
        if (!root) return;
        root.querySelectorAll('[data-post-lang]').forEach(function(el){
          const key = (el as HTMLElement).getAttribute('data-post-lang')||'';
          (el as HTMLElement).style.display = key === cur ? '' : 'none';
        });
      });
    }
    function updateAccessVisible(){
      const cur = selectedLang();
      const en = document.getElementById('access-en');
      const ja = document.getElementById('access-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateHeadingVisible(){
      const cur = selectedLang();
      const en = document.getElementById('home-title-en');
      const ja = document.getElementById('home-title-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateFeaturedVisible(){
      const cur = selectedLang();
      const en = document.getElementById('featured-en');
      const ja = document.getElementById('featured-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateStudioVisible(){
      const cur = selectedLang();
      const en = document.getElementById('studio-promo-en');
      const ja = document.getElementById('studio-promo-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updatePastTitleVisible(){
      const cur = selectedLang();
      const enTitle = document.getElementById('past-title-en');
      const jaTitle = document.getElementById('past-title-ja');
      const enMore  = document.getElementById('past-more-en');
      const jaMore  = document.getElementById('past-more-ja');
      if (enTitle) enTitle.style.display = (cur === 'en') ? '' : 'none';
      if (jaTitle) jaTitle.style.display = (cur === 'ja') ? '' : 'none';
      if (enMore)  enMore.style.display  = (cur === 'en') ? '' : 'none';
      if (jaMore)  jaMore.style.display  = (cur === 'ja') ? '' : 'none';
    }
    filterHome();
    updateAccessVisible();
    updateHeadingVisible();
    updateFeaturedVisible();
    updateStudioVisible();
    updatePastTitleVisible();
    window.addEventListener('popstate', filterHome);
    window.addEventListener('popstate', updateAccessVisible);
    window.addEventListener('popstate', updateHeadingVisible);
    window.addEventListener('popstate', updateFeaturedVisible);
    window.addEventListener('popstate', updateStudioVisible);
    window.addEventListener('popstate', updatePastTitleVisible);
    document.addEventListener('astro:page-load', () => setTimeout(filterHome, 0));
    document.addEventListener('astro:after-swap', filterHome);
    document.addEventListener('astro:page-load', () => setTimeout(updateAccessVisible, 0));
    document.addEventListener('astro:after-swap', updateAccessVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updateHeadingVisible, 0));
    document.addEventListener('astro:after-swap', updateHeadingVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updateFeaturedVisible, 0));
    document.addEventListener('astro:after-swap', updateFeaturedVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updateStudioVisible, 0));
    document.addEventListener('astro:after-swap', updateStudioVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updatePastTitleVisible, 0));
    document.addEventListener('astro:after-swap', updatePastTitleVisible);
    document.addEventListener('click', (e)=>{
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const a = (t.closest && t.closest('a')) as HTMLAnchorElement | null;
      if (a && a.closest('.pagination, [data-pagination], .bg-[var(--card-bg)]')) {
        setTimeout(filterHome, 100);
        setTimeout(updateHeadingVisible, 100);
        setTimeout(updateFeaturedVisible, 100);
        setTimeout(updateStudioVisible, 100);
        setTimeout(updatePastTitleVisible, 100);
      }
    });
    document.addEventListener('click', (e)=>{
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const id = t.id || (t.closest && (t.closest('#lang-en, #lang-ja') as HTMLElement)?.id) || '';
      if (id === 'lang-en' || id === 'lang-ja') {
        try { localStorage.setItem('preferredLang', id === 'lang-en' ? 'en' : 'ja'); } catch {}
        setTimeout(filterHome, 50);
        setTimeout(updateAccessVisible, 50);
        setTimeout(updateHeadingVisible, 50);
        setTimeout(updateFeaturedVisible, 50);
        setTimeout(updateStudioVisible, 50);
        setTimeout(updatePastTitleVisible, 50);
      }
    });
  })();
</script>

<style is:global>
  #studio {
    position: relative;
    overflow: hidden;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0), rgba(0, 0, 0, 0.432)),
      url("/images/StudioBanner.png");
    background-position: right;
    background-repeat: no-repeat;
    background-size: cover;
    image-rendering: pixelated;
  }

  #studio > * {
    position: relative;
    z-index: 1;
  }
  #studio .btn-regular-featured {
    background-color: var(--card-bg);
    border: 2px solid #d24200;
  }

  #studio-promo-ja .btn-regular-featured {
    border: 2px solid #d24200;
  }

  #studio .btn-regular-featured:hover {
    background-color: var(--bth-card-bh-hover-alt);
  }

  #studio .btn-regular-featured:active {
    background-color: var(--bth-card-bh-active-alt);
  }
</style>

</MainGridLayout>
