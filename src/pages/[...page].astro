---






import {
	type CollectionEntry,
	getCollection,
	getEntry,
	render,
} from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import PostFeatured from "@components/PostFeatured.astro";
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import I18nKey from "../i18n/i18nKey";
import { i18nFor } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getLangFromPath } from "../utils/lang";

// Helper so it works whether published is a Date or string
const toDate = (d: unknown) => (d instanceof Date ? d : new Date(String(d)));
const now = new Date();

// Load posts: exclude drafts and future-published posts
type Post = CollectionEntry<"posts">;
const posts: Post[] = await getCollection("posts", ({ data }) => {
	if (data.draft) return false;
	if (import.meta.env.PROD && new Date(data.published) > now) return false;
	return true;
});

// Choose featured posts per language: soonest upcoming featured; fallback = latest past featured
function getItemLangFromSlug(slug: string, fmLang?: string): "en" | "ja" | "" {
	const fm = fmLang?.toLowerCase?.();
	if (fm === "en" || fm === "ja") return fm as any;
	const first = String(slug).split("/")?.[0]?.toLowerCase?.();
	return first === "en" || first === "ja" ? (first as any) : "";
}
const candidates = posts.filter((p) => !!p.data.featured);
const candEn = candidates.filter(
	(p) => getItemLangFromSlug(p.slug, (p.data as any)?.lang) === "en",
);
const candJa = candidates.filter(
	(p) => getItemLangFromSlug(p.slug, (p.data as any)?.lang) === "ja",
);

const eventDateOf = (p: Post) => toDate(p.data.eventDate ?? p.data.published);

const upcomingEn = candEn
	.filter((p) => eventDateOf(p) >= now)
	.sort((a, b) => eventDateOf(a).getTime() - eventDateOf(b).getTime());
const pastEn = candEn
	.filter((p) => eventDateOf(p) < now)
	.sort((a, b) => eventDateOf(b).getTime() - eventDateOf(a).getTime());
const featuredEn: Post | undefined = upcomingEn[0] ?? pastEn[0];

const upcomingJa = candJa
	.filter((p) => eventDateOf(p) >= now)
	.sort((a, b) => eventDateOf(a).getTime() - eventDateOf(b).getTime());
const pastJa = candJa
	.filter((p) => eventDateOf(p) < now)
	.sort((a, b) => eventDateOf(b).getTime() - eventDateOf(a).getTime());
const featuredJa: Post | undefined = upcomingJa[0] ?? pastJa[0];

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const nowRef = new Date();
	const upcomingOnly = allBlogPosts.filter(
		(p) => new Date(String(p.data.eventDate ?? p.data.published)) >= nowRef,
	);
	return paginate(upcomingOnly, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;
// Filter out the featured post from the current page list to avoid duplication (both locales)
function normalizeSlug(slug: string): string {
	const parts = String(slug).split("/");
	const first = parts[0]?.toLowerCase?.();
	if (first === "en" || first === "ja") return parts.slice(1).join("/");
	return slug;
}
const excludeSet = new Set<string>(
	[
		featuredEn ? normalizeSlug(featuredEn.slug) : "",
		featuredJa ? normalizeSlug(featuredJa.slug) : "",
	].filter(Boolean),
);
const pageFiltered =
	excludeSet.size > 0
		? {
				...page,
				data: page.data.filter((p) => !excludeSet.has(normalizeSlug(p.slug))),
			}
		: page;
const len = pageFiltered.data.length;

// Localized Access content
const pathLang = getLangFromPath(Astro.url.pathname) ?? undefined;
const qLangRaw = Astro.url.searchParams.get("lang")?.toLowerCase?.();
const qLang = qLangRaw === "en" || qLangRaw === "ja" ? qLangRaw : undefined;
const routeLang = qLang ?? pathLang ?? "ja";

const accessEn = await getEntry("access" as any, "en/access" as any);
const accessJa = await getEntry("access" as any, "ja/access" as any);
const AccessEn = accessEn ? (await render(accessEn)).Content : null;
const AccessJa = accessJa ? (await render(accessJa)).Content : null;

---

<MainGridLayout>
  
    {featuredEn && (
      <div id="featured-en" data-lang="en" class="featured-post mb-8 p-6 rounded-lg bg-[var(--card-bg-featured)]" style={routeLang === 'en' ? '' : 'display:none'}>
        <PostFeatured post={featuredEn} lang="en" />
      </div>
    )}
    {featuredJa && (
      <div id="featured-ja" data-lang="ja" class="featured-post mb-8 p-6 rounded-lg bg-[var(--card-bg-featured)]" style={routeLang === 'ja' ? '' : 'display:none'}>
        <PostFeatured post={featuredJa} lang="ja" />
      </div>
    )}
  <div
    id="home-title-en"
    data-lang="en"
    class="text-5xl font-semibold text-center text-90"
    style={routeLang === 'en' ? '' : 'display:none'}
  >{i18nFor('en')(I18nKey.upcomingEvents)}</div>
  <div
    id="home-title-ja"
    data-lang="ja"
    class="text-5xl font-semibold text-center text-90"
    style={routeLang === 'ja' ? '' : 'display:none'}
  >{i18nFor('ja')(I18nKey.upcomingEvents)}</div>
    <div id="home-post-list">
      <PostPage page={pageFiltered} lang={routeLang} ></PostPage>
    </div>
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}>
      </Pagination>


<div class="card-base mt-8 h-[0.5rem] dark:bg-[var(--card-bg-featured)]"></div>


<div id="access" class="max-w-6xl mx-auto p-4 space-y-4">
  <div class="text-5xl font-semibold text-center text-90">Access</div>

  <div class="grid gap-4 md:grid-cols-3">
    <aside id="access-info" class="h-[34rem] md:col-span-1 shrink-0 text-sm rounded-xl border p-4 text-90 flex items-center">
      <Markdown class="prose prose-invert max-w-none mx-auto text-center">
        {AccessEn && (
          <div id="access-en" data-lang="en" style={routeLang === 'en' ? '' : 'display:none'}>
            <AccessEn />
          </div>
        )}
        {AccessJa && (
          <div id="access-ja" data-lang="ja" style={routeLang === 'ja' ? '' : 'display:none'}>
            <AccessJa />
          </div>
        )}
      </Markdown>
    </aside>
    <div id="access-media" class="flex flex-col gap-4 h-[34rem] md:col-span-2">
      <aside id="access-img" class="relative flex-1 w-full rounded-2xl overflow-hidden">
        <img src="/images/LocationShot.webp" alt="Access" class="w-full h-full object-cover" />
        <div aria-hidden="true" class="absolute inset-0 pointer-events-none" style="background-image: url('/images/overlays/overlay11.png'); background-repeat: repeat; opacity: 0.8;"></div>
      </aside>
      <main id="access-map" class="flex-1 w-full rounded-2xl overflow-hidden">
        <iframe
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=34.64246579608249, 135.50556859266723&z=15&output=embed">
        </iframe>
      </main>
    </div>
  </div>
</div>


<script>
  (function(){
    function selectedLang(){
      try {
        const params = new URLSearchParams(window.location.search);
        const q = (params.get('lang')||'').toLowerCase();
        if (q === 'en' || q === 'ja') return q;
        const parts = window.location.pathname.split('/').filter(Boolean);
        const first = parts[0]?.toLowerCase?.();
        if (first === 'en' || first === 'ja') return first;
        const pref = (localStorage.getItem('preferredLang')||'').toLowerCase();
        if (pref === 'en' || pref === 'ja') return pref;
      } catch {}
      return 'ja';
    }
    function filterHome(){
      const cur = selectedLang();
      const root = document.getElementById('home-post-list') || document;
      root.querySelectorAll('[data-post-lang]')
        .forEach((el)=>{
          const key = (el as HTMLElement).getAttribute('data-post-lang')||'';
          const show = key === cur;
          (el as HTMLElement).style.display = show ? '' : 'none';
        });
    }
    function updateAccessVisible(){
      const cur = selectedLang();
      const en = document.getElementById('access-en');
      const ja = document.getElementById('access-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateHeadingVisible(){
      const cur = selectedLang();
      const en = document.getElementById('home-title-en');
      const ja = document.getElementById('home-title-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateFeaturedVisible(){
      const cur = selectedLang();
      const en = document.getElementById('featured-en');
      const ja = document.getElementById('featured-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    filterHome();
    updateAccessVisible();
    updateHeadingVisible();
    updateFeaturedVisible();
    window.addEventListener('popstate', filterHome);
    window.addEventListener('popstate', updateAccessVisible);
    window.addEventListener('popstate', updateHeadingVisible);
    window.addEventListener('popstate', updateFeaturedVisible);
    document.addEventListener('astro:page-load', () => setTimeout(filterHome, 0));
    document.addEventListener('astro:after-swap', () => setTimeout(filterHome, 0));
    document.addEventListener('astro:page-load', () => setTimeout(updateAccessVisible, 0));
    document.addEventListener('astro:after-swap', () => setTimeout(updateAccessVisible, 0));
    document.addEventListener('astro:page-load', () => setTimeout(updateHeadingVisible, 0));
    document.addEventListener('astro:after-swap', () => setTimeout(updateHeadingVisible, 0));
    document.addEventListener('astro:page-load', () => setTimeout(updateFeaturedVisible, 0));
    document.addEventListener('astro:after-swap', () => setTimeout(updateFeaturedVisible, 0));
    document.addEventListener('click', (e)=>{
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const a = (t.closest && t.closest('a')) as HTMLAnchorElement | null;
      if (a && a.closest('.pagination, [data-pagination], .bg-[var(--card-bg)]')) {
        setTimeout(filterHome, 100);
        setTimeout(updateHeadingVisible, 100);
        setTimeout(updateFeaturedVisible, 100);
      }
    });
    document.addEventListener('click', (e)=>{
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const id = t.id || (t.closest && (t.closest('#lang-en, #lang-ja') as HTMLElement)?.id) || '';
      if (id === 'lang-en' || id === 'lang-ja') {
        try { localStorage.setItem('preferredLang', id === 'lang-en' ? 'en' : 'ja'); } catch {}
        setTimeout(filterHome, 50);
        setTimeout(updateAccessVisible, 50);
        setTimeout(updateHeadingVisible, 50);
        setTimeout(updateFeaturedVisible, 50);
      }
    });
  })();
</script>

</MainGridLayout>

