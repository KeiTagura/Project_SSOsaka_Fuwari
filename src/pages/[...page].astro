<script>
  (function(){
    function selectedLang(){
      try {
        const params = new URLSearchParams(window.location.search);
        const q = (params.get('lang')||'').toLowerCase();
        if (q === 'en' || q === 'ja') return q;
        const parts = window.location.pathname.split('/').filter(Boolean);
        const first = parts[0]?.toLowerCase?.();
        if (first === 'en' || first === 'ja') return first;
        const pref = (localStorage.getItem('preferredLang')||'').toLowerCase();
        if (pref === 'en' || pref === 'ja') return pref;
      } catch {}
      return 'ja';
    }
    function filterHome(){
      const cur = selectedLang();
      ['home-post-list', 'past-post-list'].forEach(function(id){
        const root = document.getElementById(id);
        if (!root) return;
        root.querySelectorAll('[data-post-lang]').forEach(function(el){
          const key = (el as HTMLElement).getAttribute('data-post-lang')||'';
          (el as HTMLElement).style.display = key === cur ? '' : 'none';
        });
      });
    }
    function updateAccessVisible(){
      const cur = selectedLang();
      const en = document.getElementById('access-en');
      const ja = document.getElementById('access-ja');
      const hoursEn = document.getElementById('open-hours-en');
      const hoursJa = document.getElementById('open-hours-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
      if (hoursEn) hoursEn.style.display = (cur === 'en') ? '' : 'none';
      if (hoursJa) hoursJa.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateHeadingVisible(){
      const cur = selectedLang();
      const en = document.getElementById('home-title-en');
      const ja = document.getElementById('home-title-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateFeaturedVisible(){
      const cur = selectedLang();
      const en = document.getElementById('featured-en');
      const ja = document.getElementById('featured-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updateStudioVisible(){
      const cur = selectedLang();
      const en = document.getElementById('studio-promo-en');
      const ja = document.getElementById('studio-promo-ja');
      if (en) en.style.display = (cur === 'en') ? '' : 'none';
      if (ja) ja.style.display = (cur === 'ja') ? '' : 'none';
    }
    function updatePastTitleVisible(){
      const cur = selectedLang();
      const enTitle = document.getElementById('past-title-en');
      const jaTitle = document.getElementById('past-title-ja');
      const enMore  = document.getElementById('past-more-en');
      const jaMore  = document.getElementById('past-more-ja');
      if (enTitle) enTitle.style.display = (cur === 'en') ? '' : 'none';
      if (jaTitle) jaTitle.style.display = (cur === 'ja') ? '' : 'none';
      if (enMore)  enMore.style.display  = (cur === 'en') ? '' : 'none';
      if (jaMore)  jaMore.style.display  = (cur === 'ja') ? '' : 'none';
    }
    filterHome();
    updateAccessVisible();
    updateHeadingVisible();
    updateFeaturedVisible();
    updateStudioVisible();
    updatePastTitleVisible();
    window.addEventListener('popstate', filterHome);
    window.addEventListener('popstate', updateAccessVisible);
    window.addEventListener('popstate', updateHeadingVisible);
    window.addEventListener('popstate', updateFeaturedVisible);
    window.addEventListener('popstate', updateStudioVisible);
    window.addEventListener('popstate', updatePastTitleVisible);
    document.addEventListener('astro:page-load', () => setTimeout(filterHome, 0));
    document.addEventListener('astro:after-swap', filterHome);
    document.addEventListener('astro:page-load', () => setTimeout(updateAccessVisible, 0));
    document.addEventListener('astro:after-swap', updateAccessVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updateHeadingVisible, 0));
    document.addEventListener('astro:after-swap', updateHeadingVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updateFeaturedVisible, 0));
    document.addEventListener('astro:after-swap', updateFeaturedVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updateStudioVisible, 0));
    document.addEventListener('astro:after-swap', updateStudioVisible);
    document.addEventListener('astro:page-load', () => setTimeout(updatePastTitleVisible, 0));
    document.addEventListener('astro:after-swap', updatePastTitleVisible);
    document.addEventListener('click', (e)=>{
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const a = (t.closest && t.closest('a')) as HTMLAnchorElement | null;
      if (a && a.closest('.pagination, [data-pagination], .bg-[var(--card-bg)]')) {
        setTimeout(filterHome, 100);
        setTimeout(updateHeadingVisible, 100);
        setTimeout(updateFeaturedVisible, 100);
        setTimeout(updateStudioVisible, 100);
        setTimeout(updatePastTitleVisible, 100);
      }
    });
    document.addEventListener('click', (e)=>{
      const t = e.target as HTMLElement | null;
      if (!t) return;
      const id = t.id || (t.closest && (t.closest('#lang-en, #lang-ja') as HTMLElement)?.id) || '';
      if (id === 'lang-en' || id === 'lang-ja') {
        try { localStorage.setItem('preferredLang', id === 'lang-en' ? 'en' : 'ja'); } catch {}
        setTimeout(filterHome, 50);
        setTimeout(updateAccessVisible, 50);
        setTimeout(updateHeadingVisible, 50);
        setTimeout(updateFeaturedVisible, 50);
        setTimeout(updateStudioVisible, 50);
        setTimeout(updatePastTitleVisible, 50);
      }
    });
  })();
</script>

