---
import StudioPage from "../components/StudioPage.astro";
---

<StudioPage lang="en" />

<script is:inline>
	const params = new URLSearchParams(window.location.search);
	if ((params.get("lang") || "").toLowerCase() === "ja") {
		params.delete("lang");
		window.location.replace(`/ja/studio/${params.toString() ? `?${params.toString()}` : ""}`);
	}
</script>
