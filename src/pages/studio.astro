---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import gameScreen from "../assets/images/gameScreen.png";
import roleScreen from "../assets/images/ssShopWorkArea.png";
import studioBanner from "../assets/images/SSStudio_Banner.png";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const studioEntry = await getEntry("spec", "studio" as any);
if (!studioEntry) {
	throw new Error("Studio page content not found");
}
const { Content } = await render(studioEntry);
const studioBannerImage = `url("${studioBanner.src}")`;
const studioGameScreenImage = `url("${gameScreen.src}")`;
const secretShopRoleImage = `url("${roleScreen.src}")`;
---

<MainGridLayout title="Studio" description="Studio">
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <Markdown class="mt-2 studio-markdown">
        <Content />
      </Markdown>
    </div>
  </div>
</MainGridLayout>

<style is:global define:vars={{ studioBannerImage, studioGameScreenImage, secretShopRoleImage }}>
  
.custom-md .custom-code {
      background: #13161a;
      border-radius: 0.875rem;

}


  .studio-foldout {
    border: 1px solid var(--line-divider);
    border-radius: 0.75rem;
    background: var(--card-bg);
    margin: 1rem 0;
    overflow: hidden;
  }

  .studio-foldout > summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.125rem;
    font-weight: 700;
    color: var(--btn-regular-bg);
    list-style: none;
    user-select: none;
  }

  .studio-foldout > summary::-webkit-details-marker {
    display: none;
  }

  .studio-foldout > summary::after {
    content: "+";
    flex: 0 0 auto;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .studio-foldout[open] > summary::after {
    transform: rotate(45deg);
  }

  .studio-foldout-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      grid-template-rows 240ms ease,
      opacity 180ms ease,
      transform 180ms ease;
    padding: 0 1.125rem;
  }

  .studio-foldout-content-inner {
    min-height: 0;
    overflow: hidden;
  }

  .studio-foldout[open]:not(.is-closing) > .studio-foldout-content {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
    padding-bottom: 1.125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-foldout > summary::after,
    .studio-foldout-content {
      transition: none;
    }
  }
  .studio-markdown :is(h1, h2, h3, h4, h5, h6) {
           font-size: xxx-large;
           line-height: 3.6rem;
           position: relative;
           text-align: center;
    /*
    color: oklch(0.29 0.02 267.24);

    oklch(0.6 0.21 22.56);
    *color: oklch(0.58 0.19 38.7);*/
  }

  .studio-markdown :is(h1, h2, h3, h4, h5, h6) .anchor {
    position: absolute;
  }

  .studio-markdown > section {
    border-radius: 0.875rem;
    margin: 1.25rem 0;
    padding: 1.25rem;
  }
  .studio-markdown > section .tags {
    height: 100%;
  }  .studio-markdown > section .tags p {
    /*justify-content: space-evenly;*/
  }
  .studio-markdown > section .tags > span{
    /*background-color: var(--card-bg);*/
  }    

  .studio-markdown > section:nth-of-type(1) > :is(h1){

  }

  .studio-markdown > section:nth-of-type(even) {
    color: oklch(0.96 0.03 94.48);
    background: var(--card-bg);
  }

  .studio-markdown > section:nth-of-type(odd) {
  color:  oklch(0.29 0.02 267.24);
    background: var(--card-bg-featured);

  }

  
  .studio-markdown > section:nth-of-type(even) > :is(h1, h2, h3, h4, h5, h6) {
  color: oklch(0.58 0.19 38.7);
}
  .studio-markdown > section:nth-of-type(odd) > :is(h1, h2, h3, h4, h5, h6) {
    color: oklch(0.96 0.03 94.48);
}

  .studio-markdown > section:nth-of-type(1) .test-panel {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    width: 90%;
    height: 20%;
    box-sizing: border-box;
    transform: translateX(-50%);
    background-color: rgba(1, 1, 1, 0.5);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .studio-markdown > section:nth-of-type(1) {
    position: relative;
    background-image:
      /*linear-gradient(rgb(0 0 0 / 0.35), rgb(0 0 0 / 0.35)),*/
      var(--studioBannerImage);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    min-height: 30rem;
  }

  .studio-markdown > section:nth-of-type(1) :is(h1, h2, h3, h4, h5, h6, p, span) {
    color: white;
  }

  .studio-markdown > section > :first-child {
    margin-top: 0;
  }

  .studio-markdown > section > :last-child {
    margin-bottom: 0;
  }

  .studio-markdown > section .studio-foldout {
    background: var(--card-bg);
  }

  .studio-markdown > section:has(> h1#what-is-secret-shop-studio) li {
    font-weight: 600;
  }

  .studio-experience-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 42%);
    gap: 1.25rem;
    align-items: stretch;
    margin-top: 1.5rem;
    width: 90%;
    margin-left: auto;
    margin-right: auto;
  }

  .studio-experience-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .studio-experience-copy > :first-child {
    margin-top: 0;
  }

  .studio-experience-copy > :last-child {
    margin-bottom: 0;
  }

  .studio-experience-image {
    width: 100%;
    height: 100%;
    min-height: 18rem;
    background-image: var(--studioGameScreenImage);
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    border-radius: 0.875rem;
    image-rendering: pixelated;
  }

  .studio-role-image {
    --studio-role-image-width: 70%;
    --studio-role-image-height: 18rem;

    width: var(--studio-role-image-width);
    height: var(--studio-role-image-height);
    margin: 1.75rem auto 0;
    background-image: var(--secretShopRoleImage);
    background-position: cover;
    background-repeat: no-repeat;
    background-size: cover;
    border-radius: 0.875rem;
  }

  @media (max-width: 768px) {
    .studio-experience-split {
      grid-template-columns: 1fr;
      width: 100%;
    }

    .studio-experience-split img {
      min-height: 14rem;
    }

    .studio-role-image {
      --studio-role-image-width: 100%;
      --studio-role-image-height: 14rem;
    }
  }
</style>

<script>
  const FOLDOUT_ANIMATION_MS = 180;

  function prepareStudioFoldout(detail: HTMLDetailsElement) {
    if (detail.dataset.foldoutReady === "true") return;

    const summary = detail.querySelector(":scope > summary");
    if (!(summary instanceof HTMLElement)) return;

    const content = document.createElement("div");
    content.className = "studio-foldout-content";
    const contentInner = document.createElement("div");
    contentInner.className = "studio-foldout-content-inner";

    for (const node of Array.from(detail.childNodes)) {
      if (node !== summary) contentInner.appendChild(node);
    }
    content.appendChild(contentInner);
    detail.appendChild(content);
    detail.dataset.foldoutReady = "true";

    summary.addEventListener("click", (event) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      event.preventDefault();

      if (detail.open) {
        if (detail.classList.contains("is-closing")) return;

        detail.classList.add("is-closing");
        window.setTimeout(() => {
          detail.open = false;
          detail.classList.remove("is-closing");
        }, FOLDOUT_ANIMATION_MS);
        return;
      }

      detail.open = true;
    });
  }

  function initStudioFoldouts() {
    document
      .querySelectorAll<HTMLDetailsElement>("details.studio-foldout")
      .forEach(prepareStudioFoldout);
  }

  initStudioFoldouts();
  document.addEventListener("astro:page-load", initStudioFoldouts);
  document.addEventListener("astro:after-swap", initStudioFoldouts);
</script>
