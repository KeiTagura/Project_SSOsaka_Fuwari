---
import HomePage from "../[...page].astro";
import type { GetStaticPaths } from "astro";
import { PAGE_SIZE } from "../../constants/constants";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts("en");
	const nowRef = new Date();
	const upcomingOnly = allBlogPosts.filter(
		(p) => new Date(String(p.data.eventDate ?? p.data.published)) >= nowRef,
	);
	return paginate(upcomingOnly, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<HomePage page={page} />