---
import ArchivePanel from "@components/ArchivePanel.svelte";
import RecurringEvents from "@components/RecurringEvents.astro";
import I18nKey from "@i18n/i18nKey";
import { i18nFor } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@/utils/content-utils";

const lang = "en";
const t = i18nFor(lang);
const sortedPostsList = await getSortedPostsList(lang);
---

<MainGridLayout title={t(I18nKey.events)}>
    <RecurringEvents lang={lang} />
    <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
</MainGridLayout>
